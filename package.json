{
  "name": "london-events",
  "version": "2.0.0",
  "private": true,
  "description": "Daily-scraped listing of talks and lectures across London institutions, published as a static site.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "scrape": "NODE_USE_ENV_PROXY=1 tsx scraper/scrape.ts",
    "site:build": "eleventy",
    "site:dev": "eleventy --serve",
    "build": "npm run scrape && npm run site:build",
    "dev": "npm run scrape && npm run site:dev",
    "validate": "tsx scraper/validate.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.0.0",
    "cheerio": "^1.0.0",
    "playwright": "^1.47.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
