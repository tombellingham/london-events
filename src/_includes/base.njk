{#- Shared page shell. Pages set `root` in their front matter: the relative
    path back to the site root ("" or "../"), so links work both locally and
    under the /london-events/ prefix on GitHub Pages. -#}
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}London Talks{% endblock %}</title>
  <meta name="description" content="{% block description %}{% endblock %}">
  <meta name="color-scheme" content="light dark">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&display=swap">
  <link rel="stylesheet" href="{{ root }}assets/style.css">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23111'/%3E%3Ctext x='16' y='23' font-family='Georgia,serif' font-size='20' font-weight='700' text-anchor='middle' fill='%23fff'%3ET%3C/text%3E%3C/svg%3E">
</head>
<body>
  <div class="page">
    <header class="masthead">
      <a class="wordmark" href="{{ root or './' }}"><span class="wordmark__cut">L</span>ONDON TALKS</a>
      <nav class="masthead__nav" aria-label="Page">{% block nav %}{% endblock %}</nav>
    </header>

    {% block content %}{% endblock %}

    <footer class="colophon">
      <p>Built from each institution's public listings; always check the event page before you go.{% block footer %}{% endblock %}</p>
    </footer>
  </div>

  {% block scripts %}{% endblock %}
  <script src="{{ root }}assets/stale.js"></script>
</body>
</html>
